# syntax=docker/dockerfile:1.6
FROM dustynv/pytorch:2.7-r36.4.0-cu128-24.04

ARG DEBIAN_FRONTEND=noninteractive

ENV PATH=/opt/modular/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.org/simple \
    PIP_EXTRA_INDEX_URL="" \
    XDG_CACHE_HOME=/data/cache \
    MODULAR_MAX_CACHE_DIR=/data/max \
    MODULAR_NVPTX_COMPILER_PATH=/usr/local/cuda/bin/ptxas \
    MODULAR_MAX_SHM_WATERMARK=0.0 \
    COLLIE_SHADOW_SOURCE_URL=http://127.0.0.1:8096 \
    COLLIE_SHADOW_PORT=8106 \
    COLLIE_SHADOW_HZ=12 \
    COLLIE_BOX_POSTPROCESS_DEVICE=cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      libgl1 \
      libglib2.0-0 \
      libgomp1 \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/modular \
    && /opt/modular/bin/pip install --no-cache-dir --upgrade pip uv \
    && /opt/modular/bin/uv pip install \
      --python /opt/modular/bin/python \
      --prerelease allow \
      --index https://whl.modular.com/nightly/simple/ \
      modular

WORKDIR /app
COPY pyproject.toml ./
RUN mkdir -p src/collie_demo \
    && touch src/collie_demo/__init__.py \
    && python3 -m pip install --no-cache-dir .
COPY src/ src/
RUN python3 -m pip install --no-cache-dir --no-deps . \
    && mojo --version \
    && max --version

EXPOSE 8106
CMD ["python3", "-m", "collie_demo.shadow_server"]
